/* Transfers different types from R to BeanShell or Java (RUtil, the API of the embedded R). */
import com.eco.bio7.rbridge.RUtil;

if (!RUtil.start()) {
	Bio7Dialog.message("R could not be started (see the console)!");
	return;
}

RUtil.exec("A <- 3");
double a = RUtil.fromRDouble("A");
System.out.println(a);

RUtil.exec("H <- 'Hello'");
String h = RUtil.fromRString("H");
System.out.println(h);

/* Logical values as numbers (TRUE = 1, FALSE = 0) */
RUtil.exec("bo <- c(TRUE, FALSE)");
double[] bo = RUtil.fromRDoubles("bo");
System.out.println(bo[0] == 1);

int[] counts = RUtil.fromRInts("1:5");
System.out.println(counts.length + " integers");

/* A data frame as a matrix (the rows as Java arrays) */
RUtil.exec("frame <- data.frame(a1 = c(10.456, 20, 15, 43), a2 = c(15, 29, 25, 43), a3 = c(15, 20, 95, 43))");
double[][] m = RUtil.fromRMatrix("as.matrix(frame)");
for (int i = 0; i < m.length; i++) {
	for (int u = 0; u < m[i].length; u++) {
		System.out.print(m[i][u] + " ");
	}
	System.out.println();
}
