/* Gets values from R after a calculation (RUtil, the API of the embedded R). */
import com.eco.bio7.rbridge.RUtil;

if (!RUtil.isAlive()) {
	Bio7Dialog.message("R is not running! Please start R first.");
	return;
}

RUtil.exec("A <- c(3, 5, 3, 6)");
RUtil.exec("B <- c(3, 6, 4, 5)");
RUtil.exec("C <- A + B");
/* The result as Java array */
double[] result = RUtil.fromRDoubles("summary(A)");
for (int i = 0; i < result.length; i++) {
	System.out.print(result[i] + " ");
}
System.out.println();
/* The printed output of R */
System.out.println(RUtil.print("C"));
