/*
An R benchmark with BeanShell (RUtil, the API of the embedded R): the time of R
and the time of the data transfer to Java.
*/
import com.eco.bio7.rbridge.RUtil;

if (!RUtil.start()) {
	Bio7Dialog.message("R could not be started (see the console)!");
	return;
}

System.out.println("1000000 random numbers in R:");
System.out.println(RUtil.print("system.time(a <- runif(1000000) * 10000)"));

long time = System.currentTimeMillis();
RUtil.exec("b <- runif(1000000) * 10000");
System.out.println("The call from Java: " + (System.currentTimeMillis() - time) / 1000.0 + " s");

time = System.currentTimeMillis();
double[] random = RUtil.fromRDoubles("runif(1000000) * 10000");
System.out.println("The call and the transfer to Java: " + (System.currentTimeMillis() - time) / 1000.0 + " s");

time = System.currentTimeMillis();
double[] values = RUtil.fromRDoubles("a");
System.out.println("The transfer of 1000000 numbers: " + (System.currentTimeMillis() - time) / 1000.0 + " s");

RUtil.exec("phi <- 1.6180339887498949; n <- floor(runif(750000) * 1000)");
System.out.println("750000 Fibonacci numbers in R:");
System.out.println(RUtil.print("system.time(f <- (phi^n - (-phi)^(-n)) / sqrt(5))"));
time = System.currentTimeMillis();
double[] fibonacci = RUtil.fromRDoubles("(phi^n - (-phi)^(-n)) / sqrt(5)");
System.out.println("The call and the transfer to Java: " + (System.currentTimeMillis() - time) / 1000.0 + " s");
RUtil.exec("rm(a, b, phi, n, f)");
