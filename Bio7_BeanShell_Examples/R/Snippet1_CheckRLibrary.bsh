/* Checks if a package is installed in R (RUtil, the API of the embedded R). */
import com.eco.bio7.rbridge.RUtil;

if (!RUtil.start()) {
	Bio7Dialog.message("R could not be started (see the console)!");
	return;
}

String packageName = "vegan";
if (RUtil.fromRDouble("requireNamespace('" + packageName + "', quietly = TRUE)") != 1) {
	Bio7Dialog.message("The package '" + packageName + "' is not installed!");
} else {
	System.out.println("The package '" + packageName + "' is installed.");
}
