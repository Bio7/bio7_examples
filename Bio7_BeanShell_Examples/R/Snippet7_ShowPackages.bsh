/* Lists all installed packages of R (RUtil, the API of the embedded R). */
import com.eco.bio7.rbridge.RUtil;

if (!RUtil.start()) {
	Bio7Dialog.message("R could not be started (see the console)!");
	return;
}

String[] installedPackages = RUtil.fromRStrings("sort(.packages(all.available = TRUE))");
for (int i = 0; i < installedPackages.length; i++) {
	System.out.println(installedPackages[i]);
}
