/*
A Java GUI for R: a summary of a selected variable of the R workspace
(RUtil, the API of the embedded R).
*/
import com.eco.bio7.rbridge.RUtil;
import javax.swing.*;
import java.awt.event.*;

if (!RUtil.isAlive()) {
	Bio7Dialog.message("R is not running! Please start R first.");
	return;
}

/* All variables of the workspace */
String[] v = RUtil.fromRStrings("ls(globalenv())");

JPanel panel = new JPanel();
panel.setLayout(null);
JLabel label = new JLabel("Please select a variable");
label.setBounds(80, 5, 260, 20);
panel.add(label);

JComboBox combo = new JComboBox();
combo.setBounds(20, 35, 260, 20);
if (v.length > 0) {
	for (int i = 0; i < v.length; i++) {
		combo.addItem(v[i]);
	}
} else {
	combo.addItem("No variables available!");
}
/* The summary of the selected variable in the console (R in a thread: the GUI is not blocked) */
itemStateChanged(ItemEvent event) {
	if (event.getStateChange() == ItemEvent.SELECTED && v.length > 0) {
		new Thread(new Runnable() {
			public void run() {
				System.out.println(RUtil.print("summary(" + combo.getSelectedItem() + ")"));
			}
		}).start();
	}
}
combo.addItemListener(this);
panel.add(combo);

CustomView view = new CustomView();
view.setPanel(panel, "R-function");
