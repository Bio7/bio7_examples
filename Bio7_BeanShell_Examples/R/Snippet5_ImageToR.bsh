/*
Transfers the active ImageJ image to R as a numeric matrix (RUtil, the API of the
embedded R): the rows are the y values of the image (the first row is the top).

In R, e.g.: image(t(img[nrow(img):1, ]), col = gray.colors(256))
*/
import com.eco.bio7.rbridge.RUtil;
import ij.WindowManager;

if (!RUtil.isAlive()) {
	Bio7Dialog.message("R is not running! Please start R first.");
	return;
}

if (WindowManager.getCurrentImage() == null) {
	System.out.println("No image opened!");
	return;
}
/* null: the active image */
RUtil.imageToR("img", null);
System.out.println(RUtil.print("dim(img)"));
/* And back: the image inverted in R as a new ImageJ image */
RUtil.imageFromR("max(img) - img", "Inverted");
