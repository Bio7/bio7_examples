import com.eco.bio7.rbridge.RBridge;
/*Get data from OpenOffice, Excel, etc. from the clipboard, if available!*/

if (RBridge.getBackend() != null) {
	RBridge.getBackend().eval("try(clip<-read.delim(\"clipboard\"))");
	System.out.println("Data in dataframe \"clip\":");
	RTools.print("clip");
} 
else {
	RTools.isAliveDialog();

}