/*
Executes an R file and prints its result (RUtil, the API of the embedded R).
More complex tasks can be written in R and called from BeanShell, e.g., both
scripts placed in the Scripts menu.
*/
import com.eco.bio7.rbridge.RUtil;

if (!RUtil.start()) {
	Bio7Dialog.message("R could not be started (see the console)!");
	return;
}

/* The path of the R file (R accepts "/" on all systems) */
String f = FileRoot.getFileRoot() + "/Bio7_BeanShell_Examples/R/Execute_Source/script.R";
RUtil.toR(".file", new String[] { f.replace("\\", "/") });
RUtil.exec("source(.file); rm(.file)");
System.out.println("The result is:");
System.out.println(RUtil.print("result"));
