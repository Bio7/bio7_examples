/*
Opens an R workspace (an .RData file) selected in a dialog (RUtil, the API of the
embedded R). A template for components which open files.
*/
import com.eco.bio7.rbridge.RUtil;

if (!RUtil.start()) {
	Bio7Dialog.message("R could not be started (see the console)!");
	return;
}

String file = Bio7Dialog.openFile();
if (file != null) {
	/* The path as value (no escaping of "\" on Windows) */
	RUtil.toR(".file", new String[] { file });
	RUtil.exec("load(file = .file); rm(.file)");
	System.out.println("Loaded: " + file);
}
